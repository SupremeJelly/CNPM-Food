{
  "uid": "loki-logs-metrics",
  "title": "Loki - Error & Volume Metrics",
  "schemaVersion": 38,
  "version": 1,
  "panels": [
    {
      "type": "timeseries",
      "title": "Error Rate (5m)",
      "datasource": "Loki",
      "gridPos": {"h": 6, "w": 12, "x": 0, "y": 0},
      "targets": [
        {
          "expr": "count_over_time({namespace=\"cnpm-food\"} |= \"ERROR\"[5m])",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Log Volume (5m)",
      "datasource": "Loki",
      "gridPos": {"h": 6, "w": 12, "x": 12, "y": 0},
      "targets": [
        {
          "expr": "count_over_time({namespace=\"cnpm-food\"}[5m])",
          "refId": "B"
        }
      ]
    }
  ],
  "templating": {"list": []},
  "time": {"from": "now-6h", "to": "now"}
}
